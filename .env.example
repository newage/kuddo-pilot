# Postgres. Overridden in docker/compose.yml under Docker
#DATABASE_URL=postgres://kuddo:kuddo@db:5432/kuddo

# Postgres (pooled). Neon: the "Pooled connection" string
#DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require
DATABASE_URL=

# Postgres without pgbouncer (direct) — for migrations on Vercel/Neon
DATABASE_URL_UNPOOLED=

# Auth.js
AUTH_SECRET=change-me
# Base URL for the OAuth redirect (not 0.0.0.0 — Google rejects it)
AUTH_URL=http://localhost:3000
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Gemini (Google AI Studio)
GEMINI_API_KEY=
GEMINI_MODEL=

# Email of the initial admin
ADMIN_EMAIL=
