# Postgres. У Docker переозначається в docker/compose.yml
#DATABASE_URL=postgres://kuddo:kuddo@db:5432/kuddo

# Postgres (pooled). Neon: рядок "Pooled connection"
#DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require
DATABASE_URL=

# Postgres без pgbouncer (direct) — для міграцій на Vercel/Neon
DATABASE_URL_UNPOOLED=

# Auth.js
AUTH_SECRET=change-me
# Базова адреса для OAuth redirect (не 0.0.0.0 — Google його відхиляє)
AUTH_URL=http://localhost:3000
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Gemini (Google AI Studio)
GEMINI_API_KEY=
GEMINI_MODEL=

# Email первинного admin
ADMIN_EMAIL=
